# Frontend-safe values and local server placeholders. Never commit real secrets.
VITE_API_BASE_URL=/.netlify/functions
VITE_APP_MODE=real
# Local aliases remain supported; production uses the MODEL_* names below.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.sudocode.chat/v1
MODEL_ALLOWED_BASE_URLS=https://api.sudocode.chat/v1
MODEL_ID=gpt-6-luna
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-6-luna
# Server-only Function setting; set to the deployed site origin.
APP_ORIGIN=http://localhost:5173
# Required for a controlled preview; never expose this in VITE_* variables.
PREVIEW_ACCESS_TOKEN=
# Optional server-side per-client limit (defaults to 20 requests per 5 minutes).
MODEL_RATE_LIMIT_MAX=20
MODEL_RATE_LIMIT_WINDOW_MS=300000
# Optional upstream timeout in milliseconds; defaults to 45000 for image/tool requests.
MODEL_UPSTREAM_TIMEOUT_MS=45000
