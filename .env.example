# Frontend-safe values only. Secrets stay in Netlify Function environment variables.
VITE_API_BASE_URL=http://localhost:8888/.netlify/functions
VITE_APP_MODE=real
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
# Server-only Function setting; set to the deployed site origin.
APP_ORIGIN=http://localhost:5173
# Required for a controlled preview; never expose this in VITE_* variables.
PREVIEW_ACCESS_TOKEN=
# Optional server-side per-client limit (defaults to 20 requests per 5 minutes).
MODEL_RATE_LIMIT_MAX=20
MODEL_RATE_LIMIT_WINDOW_MS=300000
